# Frozen measurement outputs retain their exact bytes and hashes, including
# simpleperf's trailing spaces. Do not normalize or whitespace-check them.
docs/evidence/parity-batch37/** -text -whitespace

# Imported dependency snapshots retain upstream bytes and whitespace-sensitive
# self-test fixtures. Project formatting applies to SwiftVM-owned sources.
source/runtime/externals/fmt/** -text -whitespace
source/tests/externals/catch/** -text -whitespace
# SoftFloat imports retain upstream EOF blank lines and all other whitespace checks.
source/runtime/externals/SoftFloat-3e/src/*.c -text whitespace=-blank-at-eof
