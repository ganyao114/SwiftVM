+    CHECK(before_trap && before_trap.instruction_count==1 && count_entries(before_trap.program).empty());
+    CHECK(swift::x86::BuildFunctionIR({&padded,1},0x3005,layout,{},known).error==swift::x86::BuildError::Unsupported);
